{
  "name": "web",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-social-metadata.mjs && node scripts/verify-structured-data.mjs",
    "start": "next start",
    "lint": "eslint src next.config.ts eslint.config.mjs tailwind.config.ts --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings=0",
    "test:design": "node scripts/verify-design-contract.mjs",
    "test:product-navigation-analytics": "node --experimental-strip-types scripts/verify-product-navigation-analytics.mjs",
    "test:structured-data": "node scripts/verify-structured-data.mjs",
    "verify": "pnpm lint && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "next": "~16.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.6",
      "flatted@<=3.4.1": "3.4.2",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.16"
    }
  }
}
